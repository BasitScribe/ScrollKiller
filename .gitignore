# Gradle / Android build output and machine-specific files — kept out of git.

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android SDK location (machine-specific, generated by Android Studio)
local.properties

# IDE — machine-specific Android Studio state. Anything here that differs between
# two developers' machines is noise in a diff, and this repo goes public post-launch
# (D68), so history is part of the portfolio piece.
*.iml
.idea/caches/
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/AndroidProjectSystem.xml
.idea/compiler.xml
.idea/gradle.xml
.idea/runConfigurations.xml
# misc.xml records the project JDK. It looks shareable and is not: the local note in
# PROJECT_MAP (AS ships JBR 25, Gradle's daemon wants 21) means this file says something
# different on every machine and re-dirties itself on every IDE open.
.idea/misc.xml

# Python (backend/ and tools/) — venvs, bytecode, and tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.db
*.sqlite3

# Local backend config. Only .env.example is tracked, and it holds placeholders
# only — real values live in GitHub Actions secrets or host env (D60).
.env
.env.*
!.env.example

# Obsidian per-machine UI state. The vault's NOTES are tracked (D56 treats them as
# part of the project); which panes you happen to have open is not.
ScrollKiller/.obsidian/workspace.json
ScrollKiller/.obsidian/workspace-mobile.json
# core-plugins.json is which plugins THIS machine has toggled — same class of noise.
ScrollKiller/.obsidian/core-plugins.json

# Agent/session scratch
.artifacts/

# Raw art generation output — 6.7 MB of candidates. The MASTERS the importer
# actually reads are tracked in art/mascot/; these are the discards.
mascot chatgpt/

# Build artifacts
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# Logs / OS cruft
*.log
.DS_Store
Thumbs.db
