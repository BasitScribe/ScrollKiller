<?xml version="1.0" encoding="utf-8"?>
<!--
    The manifest declares the app to Android: its Application class, icon,
    theme, and which Activity is the launcher entry point.

    Permissions:
    - SYSTEM_ALERT_WINDOW: draw the floating live-counter bubble on top of the
      tracked app. It is OPTIONAL — the bubble is a convenience; detection and
      the in-app counter work without it. Granting it is a user-driven flow
      (Settings.ACTION_MANAGE_OVERLAY_PERMISSION), gated by the second onboarding
      step; the service no-ops the bubble when Settings.canDrawOverlays is false.
    - ACTIVITY_RECOGNITION: read the step-detector/step-counter sensors for the
      physical unlock challenges (D50). Also OPTIONAL — without it the challenge is
      not offered and everything else, including the block and both ways out of it,
      is unaffected. Dangerous only on API 29+; before that the platform's step
      sensors needed no grant, which MotionStatus.hasPermission accounts for. It is
      a normal runtime permission (no Play declaration form), requested from
      MainActivity's Settings tab because an AccessibilityService has no Activity to
      request it from.
    - POST_NOTIFICATIONS: warn the user when the app CANNOT DO ITS JOB — specifically
      when a block should have fired and the overlay permission is missing (D51). It is
      an alert about the app's own health, never marketing and never re-engagement.
      Also optional, and deliberately so: without it the app is DEGRADED rather than
      broken, and the Home banner — which needs no permission at all — remains the
      guaranteed signal. Dangerous only on API 33+. Requested from the Settings tab,
      same reason as ACTIVITY_RECOGNITION above.
    - VIBRATE: the completion and hold-broken buzzes for the hold challenges (D54). The
      face-down challenge points the progress ring at a table, so the buzz is the ONLY
      feedback the user has — without it they flip the phone up to check, which breaks
      the very hold they were checking on. NORMAL permission: granted at install, no
      runtime prompt, no Settings row, nothing for the user to fix. A device with no
      vibrator gets silence and everything else still works (ChallengeHaptics no-ops).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ScrollKillerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrollKiller"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScrollKiller">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            AccessibilityService that detects Instagram reel scrolls.

            - permission BIND_ACCESSIBILITY_SERVICE: required by the system so
              only the OS can bind this service.
            - exported=true: the system (a different process) binds it, so it
              must be exported.
            - intent-filter action AccessibilityService: how the OS discovers
              services that can be enabled in Settings > Accessibility.
            - meta-data android.accessibilityservice: points at the config XML
              declaring which events/packages we observe.
        -->
        <service
            android:name=".service.ReelScrollAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
