<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen block screen shown over the reel surface once the daily limit is hit.
    Deliberately, unmistakably ScrollKiller's OWN screen — it does not mimic Instagram
    or system chrome (Play policy / never-deceive).
    The user is never trapped: Exit leaves the app and Back maps to Exit.

    NO BRAND COLOURS LIVE HERE (D58). The root background and every text colour are
    applied in CODE by BlockScreenController from Brand, because this window draws over
    another app and so is outside the Compose theme — Brand.kt is the one source both
    render paths read. Do not add an android:background or a textColor hex to this file;
    that is how the second, drifting palette came to exist in the first place.

    THREE PANELS, one window (D50, extended by D53). block_panel is the block itself;
    chooser_panel is where the user picks a challenge; challenge_panel is the challenge running.
    Exactly one is VISIBLE at a time and the ROOT never goes GONE — a child toggle inside an
    already-attached window, the same shape as the bubble's expand (D37), so neither picking nor
    starting a challenge is a second window or a window rebuild.

    ALL THREE panels carry their own Exit. That is not duplication for its own sake: a
    challenge or chooser screen offering only "Back" would be a second screen the user has to
    escape before they can escape, which is precisely what invariant 6 forbids. Adding the
    chooser added a panel to escape from, which is exactly why it got its own Exit too.

    TWO STRUCTURAL WRAPPERS, both invariant 6 (D71):

    1. The root is BlockRootView, not a plain layout. It overrides dispatchKeyEvent so hardware
       BACK escapes regardless of which view holds focus — the previous OnKeyListener only ran
       while the root itself was focused, which made the way out conditional on a focus state
       nothing enforced. Do not change this back to a bare LinearLayout/FrameLayout.

    2. The panel stack sits in a ScrollView (fillViewport=true). Every panel is wrap_content
       inside a centred stack, so at a large system font scale, on a short screen, or with a long
       guilt line, the content overflows and Exit is simply laid out past the bottom of the
       display with no way to reach it. fillViewport keeps the centring when the content is short
       and allows scrolling when it is not. An Exit that exists but cannot be touched is a trap.
-->
<com.scrollkiller.service.BlockRootView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

<ScrollView
    android:id="@+id/block_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/block_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- ===================== THE BLOCK ===================== -->
    <LinearLayout
        android:id="@+id/block_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!--
            The GUARDIAN mascot: the "stop" pose, used here and nowhere else. It is not part of
            the count-driven HEALTHY/CRACKING/FRIED machine (see com.scrollkiller.brain.MascotArt)
            — it means "the block is up", not "you scrolled this much". Fixed 120dp HIGH against
            the pre-scaled drawable for this density, so it is not resized at draw time; the width
            follows the art, which is trimmed to the character and therefore not square (D37).
        -->
        <ImageView
            android:id="@+id/block_mascot"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/mascot_cd_guardian"
            android:src="@drawable/mascot_guardian" />

        <TextView
            android:id="@+id/block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/block_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_guilt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <!--
            Exit is FIRST, and that ordering is load-bearing twice over. Visually it makes leaving
            the primary action, which is what an anti-doomscroll app should be nudging toward. More
            importantly it is the accessibility traversal order: TalkBack reaches the way OUT before
            either way to keep scrolling, so a screen-reader user is never hunting for the exit on
            an overlay covering someone else's app (CLAUDE.md invariant 6).

            Focus is no longer load-bearing here (D71). Back is handled by BlockRootView's
            dispatchKeyEvent, which runs whatever holds focus — so a Button taking focus via
            TalkBack or a keyboard can no longer silently disable the way out.
        -->
        <Button
            android:id="@+id/block_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/block_exit" />

        <!--
            THE ONLY REPRIEVE (D74). A free "5 more minutes" button used to sit above this one; it
            was removed by owner decision, so the way past the block is now earned or not taken.
            Do not reintroduce it here without reading D74 — deleting the button while leaving the
            handler, or vice versa, is how a dead control ends up on a screen covering another app.

            Note what did NOT change: Exit above is untouched, and hardware Back still maps to it
            through BlockRootView. Invariant 6 is about LEAVING, and a snooze was never a way out —
            it kept you in the app with the block deferred.

            The text is set in code, formatted from BlockLimits.CHALLENGE_GRACE_MINUTES, so the
            promise on the button and the reprieve actually granted are the same number by
            construction. The button is HIDDEN unless this device can run at least one challenge
            (ChallengeAvailability) — a control that cannot do its job has no business on a screen
            covering another app.
        -->
        <Button
            android:id="@+id/block_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ===================== THE CHOOSER ===================== -->
    <!--
        Which challenge. The user picks rather than being handed one (D53): agency helps
        compliance, and with more than one option picking FOR them means the person who cannot
        jump in a first-floor flat at 2am, or cannot walk because they are seated on a train,
        gets no way to earn their way out at all.

        The option rows are added in CODE, not declared here, because which challenges exist is
        ChallengeRegistry's business and which of them this device can run is
        ChallengeAvailability's — a row per spec in XML would be a second list to drift from the
        first. They are inserted into chooser_options.
    -->
    <LinearLayout
        android:id="@+id/chooser_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- The mascot follows you onto the chooser (D58). Without it this panel was a title and a
             stack of buttons on black, which read as a system dialog rather than as part of the app
             the user was just looking at. Reuses the pre-scaled 40dp BUBBLE asset rather than a new
             size family — it is already generated, already the right size, and costs nothing. -->
        <ImageView
            android:id="@+id/chooser_mascot"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/mascot_healthy_bubble" />

        <TextView
            android:id="@+id/chooser_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="@string/challenge_chooser_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Exit FIRST, before the options, for the same traversal reason as the block panel:
             TalkBack reaches the way out before any way to keep scrolling. -->
        <Button
            android:id="@+id/chooser_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/block_exit" />

        <LinearLayout
            android:id="@+id/chooser_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/chooser_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/challenge_cancel" />

    </LinearLayout>

    <!-- ===================== THE CHALLENGE ===================== -->
    <LinearLayout
        android:id="@+id/challenge_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- HEALTHY, not GUARDIAN: mid-challenge the user is doing the healthy thing, and the ring
             beside it is drawn in the same mint (Brand.STATE_HEALTHY) for that reason. -->
        <ImageView
            android:id="@+id/challenge_mascot"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/mascot_healthy_bubble" />

        <com.scrollkiller.challenge.ProgressRingView
            android:id="@+id/challenge_ring"
            android:layout_width="180dp"
            android:layout_height="180dp" />

        <!-- Prompt text is set in code from the spec's promptRes with its target as the format
             argument, so "Walk 20 steps" cannot disagree with the 20 the engine counts to. -->
        <TextView
            android:id="@+id/challenge_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/challenge_reward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="15sp"
            tools:ignore="HardcodedText" />

        <!-- Exit first here too, for the same traversal reason. Cancel returns to the block;
             Exit leaves Instagram. Both must be reachable without completing anything. -->
        <Button
            android:id="@+id/challenge_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/block_exit" />

        <Button
            android:id="@+id/challenge_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/challenge_cancel" />

    </LinearLayout>

</LinearLayout>

</ScrollView>

</com.scrollkiller.service.BlockRootView>
