<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen block screen shown over the reel surface once the daily limit is hit.
    Deliberately, unmistakably ScrollKiller's OWN screen — it does not mimic Instagram
    or system chrome (Play policy / never-deceive). Fixed dark colors because it draws
    over another app, outside our Compose theme (same rationale as overlay_bubble_bg).
    The user is never trapped: Exit leaves the app and Back maps to Exit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20D0D0D"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!--
        The GUARDIAN mascot: the "stop" pose, used here and nowhere else. It is not part of
        the count-driven HEALTHY/CRACKING/FRIED machine (see com.scrollkiller.brain.MascotArt)
        — it means "the block is up", not "you scrolled this much". Fixed 120dp HIGH against the
        pre-scaled drawable for this density, so it is not resized at draw time; the width
        follows the art, which is trimmed to the character and therefore not square (D37).
    -->
    <ImageView
        android:id="@+id/block_mascot"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/mascot_cd_guardian"
        android:src="@drawable/mascot_guardian" />

    <TextView
        android:id="@+id/block_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/block_title"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/block_guilt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <Button
        android:id="@+id/block_unlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/block_unlock" />

    <Button
        android:id="@+id/block_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/block_exit" />

</LinearLayout>
