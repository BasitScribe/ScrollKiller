<?xml version="1.0" encoding="utf-8"?>
<!-- User-facing text lives here, not hard-coded in Kotlin (Android convention;
     makes translation and reuse possible). -->
<resources>
    <string name="app_name">ScrollKiller</string>

    <!-- Accessibility service label + description. Shown to the user in
         Settings > Accessibility, so keep them plain and honest (Play policy).
         The description is what the system shows under the toggle, so it must
         explain what the service reads and reassure that nothing leaves the phone. -->
    <string name="accessibility_service_label">ScrollKiller Detector</string>
    <!--
        Play's Accessibility API policy requires the DECLARED function to match the actual one.
        As of D49 the service no longer only counts: it is what decides to put a full-screen
        block over a short-video feed once you pass your own daily limit, so blocking is stated
        here, in the system-facing description, and not only in the in-app disclosure dialog.
    -->
    <string name="accessibility_service_description">Counts how many reels/short videos you scroll so ScrollKiller can show your daily total, and — once you pass the daily limit you set — shows a full-screen block over that app so you can stop. You can always leave the block. It reads only scroll events in short-video feeds and which app is currently in the foreground (so the counter bubble and the block can appear over that app and go away when you leave it) — never the videos, captions, messages, or anything you view. Nothing you look at ever leaves your phone.</string>

    <!--
        Welcome screen (D78) — the FIRST screen on a fresh install, in front of the disclosure.

        It asks for nothing. That is what makes adding it legal under invariant 5: the disclosure
        still precedes any request to enable the service, and this screen only explains and hands
        off to it.

        NO CLAIM ABOUT THE USER. An earlier draft opened with "You scroll about 2 hours a day",
        which is a statement about a person we have not measured — exactly what STORE_COPY.md
        forbids, and its rule covers in-app copy, not only the listing. The question framing claims
        nothing, and it is better copy anyway: it opens the curiosity gap that motivates granting a
        permission people are rightly wary of.

        "on your phone" is load-bearing, not filler — the privacy promise is the strongest thing we
        have to offer at the moment we are about to ask for an Accessibility Service.
    -->
    <string name="welcome_title">How much do you actually scroll?</string>
    <string name="welcome_body">Most people guess low. ScrollKiller counts every reel and short you watch — on your phone — and shows you the real number.</string>
    <string name="welcome_preview_label">Today</string>
    <string name="welcome_preview_hint">Counting starts when you turn it on</string>
    <string name="welcome_cta">Show me</string>
    <string name="welcome_privacy">No account. Nothing leaves your phone.</string>

    <!-- Disclosure screen (shown BEFORE we send the user to Settings — invariant #5). -->
    <string name="disclosure_title">One permission to count your scrolling</string>
    <string name="disclosure_what_title">What it does</string>
    <string name="disclosure_what_body">ScrollKiller uses an Accessibility Service to notice when you swipe through reels and short videos, so it can count them.</string>
    <string name="disclosure_privacy_title">What stays private</string>
    <string name="disclosure_privacy_body">It reads only scroll events — the swipe itself. It never reads the videos, captions, messages, passwords, or anything else on your screen. Nothing you view ever leaves your phone; only your daily counts are stored.</string>
    <string name="disclosure_why_title">Why it\'s needed</string>
    <string name="disclosure_why_body">Android has no other way for an app to know you\'re doomscrolling in another app. This is the permission that makes the counter — and the blocking — possible.</string>
    <string name="disclosure_enable_button">Enable in Settings</string>

    <!-- Instruction card shown after tapping Enable, to guide the manual toggle. -->
    <string name="onboarding_instruction_title">In the next screen</string>
    <string name="onboarding_instruction_body">Find \"ScrollKiller Detector\" in the list, open it, and turn the toggle On. Then press Back to return here.</string>

    <!-- Home screen live counter. -->
    <string name="home_counter_label">reels scrolled today</string>

    <!-- Dashboard bottom-nav tabs (Phase 2). -->
    <string name="tab_today">Today</string>
    <string name="tab_apps">Apps</string>
    <string name="tab_settings">Settings</string>

    <!-- Today tab. %1$s is a minutes value like "4.8". -->
    <string name="today_time_estimate">~%1$s mins scrolling today</string>
    <string name="today_breakdown_title">By app</string>
    <!-- %1$d is blocking-app total, %2$d the daily limit. YouTube is BETA but still in the lock. -->
    <string name="today_limit_progress">%1$d of %2$d toward the lock</string>
    <string name="today_limit_covers">Lock counts: %1$s</string>
    <string name="today_beta_footnote">BETA means the count is still being tuned. TikTok and Snapchat are counted here; they do not lock the screen.</string>

    <!-- Insights tab (D82). Replaces the old Apps tab, whose per-app bars were today-only and
         already duplicated by the Today tab's "By app" card; this adds the range dimension. -->
    <string name="tab_insights">Insights</string>
    <string name="insights_range_week">7 days</string>
    <string name="insights_range_month">Weekly</string>
    <!-- %1$d is the range total. The noun is deliberately generic: the total spans platforms that
         count "reels", "shorts" and "snaps" (same rule as the bubble panel and the limit slider). -->
    <string name="insights_total">%1$d short videos</string>
    <string name="insights_daily_average">%1$d/day avg</string>
    <string name="insights_limit_line">limit %1$d</string>
    <string name="insights_streak_current">day streak</string>
    <string name="insights_streak_best">best</string>
    <string name="insights_time_measured">measured</string>
    <!-- The D80 ramp, said out loud. Shown ONLY when the time figure covers less of the range than
         the counts do, so it never appears once the rollup has caught up. %1$s is a date. -->
    <string name="insights_time_from">Time measured since %1$s · earlier days show counts only</string>
    <string name="insights_time_none">Time starts being measured today · counts go back further</string>
    <!-- The in-progress bucket. Without this an incomplete week reads as a collapse in usage. -->
    <string name="insights_partial_week">This week so far</string>
    <string name="insights_by_app">By app</string>
    <string name="insights_empty_title">Nothing to chart yet</string>
    <string name="insights_empty_body">Once you scroll Instagram, YouTube, TikTok or Snapchat, your daily totals and streaks show up here.</string>

    <!--
        Milestones (D83). The counterweight to the guilt engine: the block screen keeps the scolding,
        this is where warmth lives. A LOCKED milestone shows progress toward it and never a reproach
        — "4 of 7", not "you failed" — because an app that only ever scolds gets uninstalled out of
        shame, which is the finding D78's research turned up and D9 anticipated.

        Names are achievements, not instructions. "A quiet week" rather than "Stay under for 7 days".
    -->
    <string name="milestones_title">Your wins</string>
    <string name="milestones_count">%1$d of %2$d</string>
    <string name="milestones_progress">%1$d of %2$d</string>
    <string name="milestone_first_day_under">First day under</string>
    <string name="milestone_streak_3">Three in a row</string>
    <string name="milestone_streak_7">A quiet week</string>
    <string name="milestone_streak_14">Two quiet weeks</string>
    <string name="milestone_streak_30">A quiet month</string>
    <string name="milestone_total_10">Ten good days</string>
    <string name="milestone_total_50">Fifty good days</string>
    <string name="milestones_empty">Your first day under the limit unlocks the first one.</string>

    <!-- Apps tab. -->
    <string name="apps_title">Apps</string>

    <!--
        Empty states (D78). Shown when nothing has been counted yet — a fresh install, or the first
        minutes after Clear all data.

        The tone rule: an empty state here must NOT read as failure or as a scold. Nothing being
        counted is the app's best-case outcome, not an error, and this is also the very first thing
        a brand-new user sees after granting the permission. So it explains what will happen rather
        than apologising for a blank box.
    -->
    <string name="empty_today_title">Nothing counted yet</string>
    <string name="empty_today_body">Open Instagram Reels, YouTube Shorts, TikTok or Snapchat Spotlight and the count starts here.</string>
    <string name="empty_apps_body">Once you scroll a tracked app, it shows up here with its own bar.</string>

    <!-- Settings tab. -->
    <string name="settings_status_on">On</string>
    <string name="settings_status_off">Off</string>
    <string name="settings_manage">Manage</string>
    <string name="settings_accessibility_title">Detection service</string>
    <string name="settings_overlay_title">Display over other apps</string>
    <string name="settings_bubble_title">Floating counter bubble</string>
    <string name="settings_bubble_subtitle">Show your live count over reels while you scroll</string>
    <!-- Daily limit slider (D76, superseding D49's one-row-per-platform). ONE budget across every
         blocking app combined, so there is no platform name to interpolate any more. No unit noun
         either: the total spans platforms that count "reels", "shorts" and "snaps", so naming one
         would be wrong — "short videos" is the honest collective term.
         settings_limit_covers names which apps are in the budget; %1$s is a " · "-joined list
         built from blocksAtLimit, never hardcoded, so it cannot claim an app it does not enforce. -->
    <string name="settings_limit_title">Daily scroll limit</string>
    <string name="settings_limit_subtitle">Block after %1$d short videos a day, across all apps</string>
    <string name="settings_limit_covers">Counts: %1$s</string>
    <!-- Motion access (D50). Shown only on devices that actually have a step sensor: asking for
         a permission that would unlock nothing is worse than staying quiet. -->
    <string name="settings_motion_title">Motion &amp; step access</string>
    <string name="settings_motion_subtitle">Lets you walk off the block instead of tapping past it</string>
    <string name="settings_motion_grant">Grant</string>
    <!-- Permission-health alerts (D51). -->
    <string name="settings_alerts_title">Permission alerts</string>
    <string name="settings_alerts_subtitle">Warn me if ScrollKiller stops being able to block</string>

    <!--
        Permission-health banner + notification (D51). The copy NAMES the permission every time:
        "tap to fix" with no noun is what people learn to ignore, and this is the one message that
        has to be believed the first time.
    -->
    <string name="health_banner_title">ScrollKiller is not fully active</string>
    <string name="health_banner_accessibility">The detection service is off — nothing is being counted.</string>
    <string name="health_banner_overlay">Display over other apps is off, so the block can\'t appear. Your reels are still being counted.</string>
    <!--
        The ROM-lies case (D52): the permission reads as GRANTED and the window is still refused.
        The copy must NOT say "grant the permission" — the user would open Settings, see the
        switch already on, and conclude we are broken. Toggling it off and on is genuinely the fix
        on the devices that do this, so that is what it says.
    -->
    <string name="health_banner_overlay_blocked">Your device is blocking ScrollKiller from drawing over other apps, even though the permission looks granted. Counting still works. Try turning \"Display over other apps\" off and on again.</string>
    <string name="health_banner_degraded_title">Heads-up alerts are off</string>
    <string name="health_banner_notifications">ScrollKiller works, but it can\'t warn you if blocking ever stops working while you\'re in another app.</string>
    <string name="health_banner_fix">Fix</string>

    <string name="notif_channel_health">App health</string>
    <string name="notif_channel_health_description">Warns you when ScrollKiller can\'t block, so it never fails silently.</string>
    <string name="notif_block_unavailable_title">You hit your limit — ScrollKiller can\'t block</string>
    <string name="notif_block_unavailable_early_title">ScrollKiller can\'t block right now</string>
    <string name="notif_block_unavailable_body">Display over other apps is off. Your reels are still being counted, but nothing will stop you. Tap to turn it back on.</string>
    <!-- Guilt-pack picker (D43). The pack NAMES are chrome and are translated; the guilt LINES
         themselves are not and never will be — they live in assets/guilt_pack.json, tagged with
         the audience they were written for. -->
    <string name="settings_pack_title">Guilt pack</string>
    <string name="settings_pack_subtitle">Whose voice roasts you when the count climbs</string>
    <string name="guilt_pack_en_in">India — Gen Z</string>
    <string name="settings_clear_title">Clear all data</string>
    <string name="settings_clear_subtitle">Delete every stored count on this device</string>
    <string name="settings_clear_button">Clear</string>
    <string name="settings_cancel">Cancel</string>
    <string name="settings_clear_confirm_title">Clear all data?</string>
    <string name="settings_clear_confirm_body">This deletes all your scroll counts on this device. It can\'t be undone.</string>

    <!-- Overlay permission screen (second onboarding step — OPTIONAL, skippable). -->
    <string name="overlay_title">See your count without leaving the app</string>
    <string name="overlay_body">Let ScrollKiller float a tiny bubble — a brain and your live count — on top of reels while you scroll. You watch the number climb without opening ScrollKiller. It shows only inside tracked short-video apps and disappears everywhere else. This is optional: counting still works without it.</string>
    <string name="overlay_instruction_title">In the next screen</string>
    <string name="overlay_instruction_body">Turn on \"Allow display over other apps\" for ScrollKiller, then press Back to return here.</string>
    <string name="overlay_enable_button">Allow the bubble</string>
    <string name="overlay_skip_button">Not now</string>
    <!-- Brain-state labels shown on Home under the count (see com.scrollkiller.brain.BrainState). -->
    <string name="brain_state_healthy">Healthy</string>
    <string name="brain_state_cracking">Cracking</string>
    <string name="brain_state_fried">Fried</string>

    <!-- Mascot screen-reader descriptions (see com.scrollkiller.brain.MascotArt). The mascot IS
         the severity signal, so these describe the state rather than saying "image". -->
    <string name="mascot_cd_healthy">Your brain is healthy</string>
    <string name="mascot_cd_cracking">Your brain is starting to crack</string>
    <string name="mascot_cd_fried">Your brain is fried</string>
    <string name="mascot_cd_guardian">Your brain is blocking reels</string>

    <!-- Full-screen block screen (Phase 2). Clearly ScrollKiller's own UI. -->
    <string name="block_title">Reels are Locked</string>
    <string name="block_exit">Exit</string>
    <!-- block_snooze ("%1$d more minutes") is DELETED at D77 — STRICT MODE. It was removed at
         D74, restored at D75 pending a product call, and that call is now made: challenge or exit,
         no free bail. Do not re-add the string alone; a translated string with no control is
         invisible and a control with no handler is worse, so string/button/handler move together.

         Invariant 6 is untouched by this and always was: a snooze deferred the block and kept the
         user IN the app. Exit and hardware Back are what invariant 6 names, and both remain on
         every panel — including on a device where no challenge is available at all. -->

    <!-- Physical unlock challenges (D50). The block-panel button names its REWARD. Since D77 it is
         the ONLY reprieve on the screen. It no longer names a specific challenge — the user picks
         one on the chooser (D53) — so the cost is named per option there instead.
         Minutes is a format arg from BlockLimits.CHALLENGE_GRACE_MINUTES, never written as copy. -->
    <string name="block_challenge">Earn your way out — %1$d minutes</string>

    <!-- The chooser (D53). challenge_option wraps each spec's own prompt so cost and reward stay
         named together without a second per-challenge string to drift from the first: %1$s is the
         spec's promptRes already formatted with its target, %2$d is the shared reward. -->
    <string name="challenge_chooser_title">Pick your way out</string>
    <string name="challenge_option">%1$s — %2$d minutes</string>
    <string name="challenge_surprise">Surprise me</string>

    <!-- One prompt per challenge, each taking its target as the single format arg so the sentence
         cannot drift from the number the engine counts to. -->
    <string name="challenge_walk_prompt">Walk %1$d steps</string>
    <string name="challenge_jump_prompt">Jump %1$d times</string>
    <string name="challenge_shake_prompt">Shake the phone %1$d times — hard enough to mean it</string>
    <string name="challenge_flip_prompt">Turn the phone over %1$d times — all the way, each time</string>
    <!-- The hold prompts state the RESET rule up front. It has to be a promise, not a surprise: a
         user who learns about it by losing 25 seconds reads the challenge as broken. -->
    <string name="challenge_face_down_prompt">Phone face down for %1$d seconds — lift it and the timer restarts</string>
    <string name="challenge_forehead_prompt">Hold the phone to your forehead for %1$d seconds — take it away and the timer restarts</string>
    <string name="challenge_balance_prompt">Balance the phone flat on your palm for %1$d seconds — tip it and the timer restarts</string>
    <string name="challenge_reward">Finish and you get %1$d minutes</string>
    <string name="challenge_cancel">Back</string>
    <!-- NOTE: guilt lines are NOT string resources. They live in assets/guilt_pack.json so the
         pack can be categorised, weighted, INTENSITY-TIERED, rotated daily, filtered by
         audience, and later swapped from a server without an app update (D33/D41/D42/D43) — a
         <string-array> can do none of those. There are exactly three guilt strings anywhere in
         the app's code or resources, and they are the crash fallback in GuiltPack.FALLBACK.
         See com.scrollkiller.guilt. -->

    <!-- Badge next to a platform whose count isn't calibrated yet (D32). Short by design:
         it sits inline next to the app name. -->
    <string name="badge_beta">BETA</string>

    <!-- Top line of the overlay bubble's expanded breakdown panel (D37). %1$d is today's grand
         total, %2$s a minutes value like "4.8". Deliberately has no unit noun: the total spans
         platforms that count "reels", "shorts" and "snaps", so naming one of them would be
         wrong. Terse because it sits in a ~200dp panel over someone's video. -->
    <string name="overlay_panel_total">%1$d in ~%2$s min</string>
</resources>
