<?xml version="1.0" encoding="utf-8"?>
<!-- User-facing text lives here, not hard-coded in Kotlin (Android convention;
     makes translation and reuse possible). -->
<resources>
    <string name="app_name">ScrollKiller</string>

    <!-- Accessibility service label + description. Shown to the user in
         Settings > Accessibility, so keep them plain and honest (Play policy).
         The description is what the system shows under the toggle, so it must
         explain what the service reads and reassure that nothing leaves the phone. -->
    <string name="accessibility_service_label">ScrollKiller Detector</string>
    <string name="accessibility_service_description">Counts how many reels/short videos you scroll so ScrollKiller can show your daily total. It reads only scroll events in short-video feeds and which app is currently in the foreground (so the counter bubble can appear over that app and hide when you leave it) — never the videos, captions, messages, or anything you view. Nothing you look at ever leaves your phone.</string>

    <!-- Disclosure screen (shown BEFORE we send the user to Settings — invariant #5). -->
    <string name="disclosure_title">One permission to count your scrolling</string>
    <string name="disclosure_what_title">What it does</string>
    <string name="disclosure_what_body">ScrollKiller uses an Accessibility Service to notice when you swipe through reels and short videos, so it can count them.</string>
    <string name="disclosure_privacy_title">What stays private</string>
    <string name="disclosure_privacy_body">It reads only scroll events — the swipe itself. It never reads the videos, captions, messages, passwords, or anything else on your screen. Nothing you view ever leaves your phone; only your daily counts are stored.</string>
    <string name="disclosure_why_title">Why it\'s needed</string>
    <string name="disclosure_why_body">Android has no other way for an app to know you\'re doomscrolling in another app. This is the permission that makes the counter — and the blocking — possible.</string>
    <string name="disclosure_enable_button">Enable in Settings</string>

    <!-- Instruction card shown after tapping Enable, to guide the manual toggle. -->
    <string name="onboarding_instruction_title">In the next screen</string>
    <string name="onboarding_instruction_body">Find \"ScrollKiller Detector\" in the list, open it, and turn the toggle On. Then press Back to return here.</string>

    <!-- Home screen live counter. -->
    <string name="home_counter_label">reels scrolled today</string>

    <!-- Dashboard bottom-nav tabs (Phase 2). -->
    <string name="tab_today">Today</string>
    <string name="tab_apps">Apps</string>
    <string name="tab_settings">Settings</string>

    <!-- Today tab. %1$s is a minutes value like "4.8". -->
    <string name="today_time_estimate">~%1$s mins scrolling today</string>
    <string name="today_breakdown_title">By app</string>

    <!-- Apps tab. -->
    <string name="apps_title">Apps</string>

    <!-- Settings tab. -->
    <string name="settings_status_on">On</string>
    <string name="settings_status_off">Off</string>
    <string name="settings_manage">Manage</string>
    <string name="settings_accessibility_title">Detection service</string>
    <string name="settings_overlay_title">Display over other apps</string>
    <string name="settings_bubble_title">Floating counter bubble</string>
    <string name="settings_bubble_subtitle">Show your live count over reels while you scroll</string>
    <string name="settings_clear_title">Clear all data</string>
    <string name="settings_clear_subtitle">Delete every stored count on this device</string>
    <string name="settings_clear_button">Clear</string>
    <string name="settings_cancel">Cancel</string>
    <string name="settings_clear_confirm_title">Clear all data?</string>
    <string name="settings_clear_confirm_body">This deletes all your scroll counts on this device. It can\'t be undone.</string>

    <!-- Overlay permission screen (second onboarding step — OPTIONAL, skippable). -->
    <string name="overlay_title">See your count without leaving the app</string>
    <string name="overlay_body">Let ScrollKiller float a tiny bubble — a brain and your live count — on top of reels while you scroll. You watch the number climb without opening ScrollKiller. It shows only inside tracked short-video apps and disappears everywhere else. This is optional: counting still works without it.</string>
    <string name="overlay_instruction_title">In the next screen</string>
    <string name="overlay_instruction_body">Turn on \"Allow display over other apps\" for ScrollKiller, then press Back to return here.</string>
    <string name="overlay_enable_button">Allow the bubble</string>
    <string name="overlay_skip_button">Not now</string>
    <!-- Brain-state labels shown on Home under the count (see com.scrollkiller.brain.BrainState). -->
    <string name="brain_state_healthy">Healthy</string>
    <string name="brain_state_cracking">Cracking</string>
    <string name="brain_state_fried">Fried</string>

    <!-- Mascot screen-reader descriptions (see com.scrollkiller.brain.MascotArt). The mascot IS
         the severity signal, so these describe the state rather than saying "image". -->
    <string name="mascot_cd_healthy">Your brain is healthy</string>
    <string name="mascot_cd_cracking">Your brain is starting to crack</string>
    <string name="mascot_cd_fried">Your brain is fried</string>
    <string name="mascot_cd_guardian">Your brain is blocking reels</string>

    <!-- Full-screen block screen (Phase 2). Clearly ScrollKiller's own UI. -->
    <string name="block_title">Reels are Locked</string>
    <string name="block_exit">Exit</string>
    <string name="block_unlock">Unlock</string>
    <!-- NOTE: guilt lines are NOT string resources. They live in assets/guilt_pack.json so the
         pack can be categorised, weighted, and later swapped from a server without an app
         update (D33) — a <string-array> can do none of those. See com.scrollkiller.guilt. -->

    <!-- Badge next to a platform whose count isn't calibrated yet (D32). Short by design:
         it sits inline next to the app name. -->
    <string name="badge_beta">BETA</string>

    <!-- Top line of the overlay bubble's expanded breakdown panel (D37). %1$d is today's grand
         total, %2$s a minutes value like "4.8". Deliberately has no unit noun: the total spans
         platforms that count "reels", "shorts" and "snaps", so naming one of them would be
         wrong. Terse because it sits in a ~200dp panel over someone's video. -->
    <string name="overlay_panel_total">%1$d in ~%2$s min</string>
</resources>
