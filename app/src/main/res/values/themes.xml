<?xml version="1.0" encoding="utf-8"?>
<!--
    The base Android (XML) theme, applied by the manifest. This is what paints
    the window BEFORE Compose renders (initial background, no action bar). Once
    Compose draws, ScrollKillerTheme (Kotlin) controls all the real styling.

    A matching dark variant lives in values-night/themes.xml.
    Uses framework themes so we don't need the extra Material Components library.
-->
<resources>
    <!--
        windowBackground is set so the launch window paints the BRAND canvas instead of the
        framework's white. Without it there is a white flash before Compose's first frame,
        which on a dark-theme device is genuinely unpleasant.

        @color/brand_window mirrors Brand.CANVAS — see colors.xml for why this one value is
        allowed to live outside Brand.kt (D58).
    -->
    <style name="Theme.ScrollKiller" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_window</item>
    </style>
</resources>
