<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded pill background for the floating live-counter bubble. A vector shape (no
    raster asset) keeps the overlay cheap. Semi-opaque dark fill so the 🧠 + count
    stay legible over any reel; the fixed colors are intentional (the bubble draws
    over other apps, not inside our theme).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E60D0D0D" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
